{
  "name": "devmate-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DevMate AI - 통합 AI 개인 워크스페이스",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup": "npm run db:deploy -w apps/api",
    "db:backup": "node scripts/backup-db.mjs",
    "db:verify-backup": "node scripts/verify-backup.mjs",
    "test:ops": "node --test scripts/*.test.mjs",
    "server:start": "powershell -NoProfile -File scripts/start-server.ps1",
    "server:status": "node scripts/server-control.mjs",
    "server:stop": "node scripts/server-control.mjs stop",
    "server:autostart": "powershell -NoProfile -File scripts/install-autostart.ps1",
    "server:autostart:remove": "powershell -NoProfile -File scripts/install-autostart.ps1 -Remove",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run start:dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api && npm run test -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
