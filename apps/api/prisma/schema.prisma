// DevMata AI 데이터베이스 스키마 (SQLite, 파일 하나에 저장)
// 스키마를 바꾼 뒤에는 `npm run db:migrate -w apps/api -- --name <변경이름>` 으로 마이그레이션을 만든다.
// enum 대신 문자열 + 서버 검증(class-validator)을 사용한다.
// SQLite는 문자열 길이를 강제하지 않으므로, 최대 길이는 API 입력 검증(class-validator)에서 지킨다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsArticle {
  id          String    @id @default(cuid())
  url         String    @unique
  title       String
  source      String
  category    String
  excerpt     String
  publishedAt DateTime?
  collectedAt DateTime  @default(now())

  @@index([publishedAt])
}

model NewsCollectionState {
  id            String    @id @default("daily")
  completedDay  String?
  lastAttemptAt DateTime?
  /// 자동·수동 상관없이 마지막으로 피드를 받아 온 시각 (한 곳이라도 성공)
  lastCollectedAt DateTime?
  lastResult    String    @default("{}")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  sessionVersion Int @default(0)
  resetTokenHash String? @unique
  resetTokenExpiresAt DateTime?
  notificationInApp Boolean @default(true)
  notificationEmail Boolean @default(true)
  /// 아침 브리핑: 매일 이 시각(한국 시간, 0~23시) 뒤 처음 확인할 때 한 번 보낸다
  briefingEnabled Boolean @default(true)
  briefingHour Int @default(7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks         Task[]
  events        Event[]
  integrations  Integration[]
  aiUsageLogs   AiUsageLog[]
  studySubjects StudySubject[]
  studyNotes    StudyNote[]
  projects      Project[]
  assistantActions AssistantAction[]
  assistantMessages AssistantMessage[]
  notifications Notification[]
}

model Notification {
  id String @id @default(cuid())
  userId String
  targetType String
  targetId String
  deadlineAt DateTime
  milestone String
  title String
  body String
  href String
  readAt DateTime?
  /// 사용자가 알림함에서 지운 시각. 마감 확인이 같은 알림을 다시 만들지 않도록 행은 남겨 둔다
  dismissedAt DateTime?
  createdAt DateTime @default(now())
  emailSentAt DateTime?
  emailAttempts Int @default(0)
  nextEmailAttemptAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([targetType, targetId, deadlineAt, milestone])
  @@index([userId, createdAt])
}

/// 할 일. priority: LOW | MEDIUM | HIGH | URGENT, category: GENERAL | STUDY | DEV | SCHOOL | PERSONAL
model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  priority    String    @default("MEDIUM")
  category    String    @default("GENERAL")
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  /// 반복: DAILY | WEEKDAYS | WEEKLY | MONTHLY. 완료하면 다음 마감일로 새 할 일을 만든다 (마감일 필수)
  repeat      String?
  /// 데모 데이터 여부 (실제 데이터와 구분)
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, dueDate])
}

/// AI 비서 대화 (새 채팅을 누르기 전까지 남는다). meta 는 JSON: actions·demo·provider·model
model AssistantMessage {
  id String @id @default(cuid())
  userId String
  role String
  content String
  meta String @default("{}")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model AssistantAction {
  id String @id @default(cuid())
  userId String
  kind String
  targetId String
  targetTitle String
  payload String
  targetUpdatedAt DateTime
  expiresAt DateTime
  consumed Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Project {
  id String @id @default(cuid())
  userId String
  name String
  goal String
  description String
  repository String @default("")
  /// 이 PC의 프로젝트 폴더 절대 경로 (선택). AI 진행률 분석 시 읽기 전용으로만 사용
  localPath String @default("")
  status String @default("ACTIVE")
  /// AI가 프로젝트 파일을 근거로 추정한 진행률 (0~100). 작업 완료 기준 진행률과 별개
  aiProgress Int?
  /// AI 추정 근거 (JSON: summary, done, remaining, confidence, sources)
  aiProgressDetail String?
  aiProgressAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ProjectItem[]
  reports ProjectReport[]
  devLogs DevLog[]
  @@index([userId])
}
/// 개발일지: 하루(한국 시간) 커밋을 모아 정리한 글. 프로젝트·날짜마다 하나
model DevLog {
  id String @id @default(cuid())
  projectId String
  /// YYYY-MM-DD (한국 시간)
  day String
  content String
  commitCount Int
  /// JSON: 커밋 출처·요약 (sha, 제목, 출처)
  commits String
  provider String
  demo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, day])
}
model ProjectItem {
  id String @id @default(cuid())
  projectId String
  title String
  kind String @default("TASK")
  status String @default("TODO")
  notes String
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, status])
}
model ProjectReport {
  id String @id @default(cuid())
  projectId String
  content String
  demo Boolean @default(false)
  provider String
  evidence String
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}

/// 일정. source: LOCAL | GOOGLE (외부 동기화 시 externalId 사용)
model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  color       String?
  category    String   @default("GENERAL")
  source      String   @default("LOCAL")
  externalId  String?
  /// 반복: DAILY | WEEKDAYS | WEEKLY | MONTHLY (한국 시간 달력 기준). 행은 하나, 조회할 때 펼친다
  repeat      String?
  /// 반복 끝 (이 시각 이후에 시작하는 회차는 없음). 없으면 계속
  repeatUntil DateTime?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, startAt])
}

/// 외부 서비스 연결 정보. provider: GOOGLE_CALENDAR | NOTION | GITHUB
/// 토큰은 프론트엔드로 절대 내보내지 않는다.
model Integration {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  status       String    @default("DISCONNECTED")
  accessToken  String?
  refreshToken String?
  scope        String?
  expiresAt    DateTime?
  /// JSON 문자열 (계정명 등 공개 가능한 메타데이터)
  metadata     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// AI 호출 기록 (사용량 / 오류 관리). 프롬프트 원문은 저장하지 않는다.
model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  provider     String
  model        String?
  feature      String
  success      Boolean
  errorMessage String?
  latencyMs    Int
  inputChars   Int
  outputChars  Int
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model StudySubject {
  id        String      @id @default(cuid())
  userId    String
  name      String
  color     String      @default("#8b5cf6")
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     StudyNote[]

  @@unique([userId, name])
  @@index([userId])
}

model StudyNote {
  id            String        @id @default(cuid())
  userId        String
  subjectId     String?
  title         String
  /// 최대 50,000자
  content       String
  /// JSON 배열 문자열 (최대 20개 × 40자)
  tags          String        @default("[]")
  progress      Int           @default(0)
  lastStudiedAt DateTime?
  nextReviewAt  DateTime?
  reviewCount   Int           @default(0)
  notionPageId  String?
  notionSavedAt DateTime?
  notionHash    String?
  isDemo        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       StudySubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([userId, notionPageId])
  @@index([userId, nextReviewAt])
  @@index([userId, subjectId])
}

/// 앱 전체(PC 단위) 설정. .env 대신 설정 화면에서 입력한 값. 비밀값은 암호화된 문자열(v1.iv.tag.data)로 저장한다.
/// key 예: google.clientId, google.clientSecret, notion.token. 값이 없으면 .env 값을 쓴다.
model AppSetting {
  key       String   @id
  value     String
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
