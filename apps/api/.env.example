# ───────── 서버 ─────────
PORT=3000
# API 서버 실행 중 한국 시간 매일 오전 7시 뉴스 수집 (false로 비활성화)
NEWS_AUTO_COLLECT=true
# 프론트엔드 주소 (CORS 허용)
WEB_ORIGIN=http://localhost:5173

# ───────── DB ─────────
# MySQL 8 (README의 MySQL 설정 참고). 테스트는 이름 끝에 _test 를 붙인 별도 DB를 자동으로 사용
DATABASE_URL="mysql://devmate:비밀번호@localhost:3306/devmate"

# ───────── 인증 ─────────
# 반드시 길고 무작위인 값으로 변경 (예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 마감 알림을 Windows 화면 알림(토스트)으로 표시. 끄려면 false
DESKTOP_NOTIFICATIONS=true

# ───────── 메일 (비밀번호 재설정 / 마감 알림) ─────────
# 비워두면 메일 발송 비활성화. 재설정 링크는 WEB_ORIGIN 기준 (운영 시 HTTPS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ───────── AI ─────────
# claude-cli: 이 PC의 Claude Code(구독 로그인) 사용 / anthropic-api: API 키 사용 / demo: 가짜 응답
AI_PROVIDER=claude-cli
# claude 실행 파일 경로 (PATH에 있으면 claude 그대로)
CLAUDE_CLI_PATH=claude
# 비워두면 Claude Code 기본 모델 사용. 예: sonnet, opus, haiku
CLAUDE_CLI_MODEL=
CLAUDE_CLI_TIMEOUT_MS=120000

# anthropic-api 사용 시에만 필요
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ───────── 외부 연동 (Phase 2~4, 비워두면 데모 모드) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud 콘솔 → OAuth 클라이언트(웹 애플리케이션)의 "승인된 리디렉션 URI" 에 아래 주소를 그대로 등록
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Notion: https://www.notion.so/my-integrations 에서 Internal Integration 생성 후 토큰 입력.
# 가져올/저장할 페이지마다 ··· → 연결(Connections)에서 integration 을 추가해야 접근 가능.
NOTION_TOKEN=
# 학습 노트를 Notion 에 새 페이지로 저장할 때 상위 페이지 (링크 또는 32자리 ID)
NOTION_PARENT_PAGE_ID=
GITHUB_TOKEN=
